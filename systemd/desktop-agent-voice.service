[Unit]
Description=Desktop Agent voice daemon
Documentation=https://github.com/Zedster07/omarchy-desktop-agent
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The daemon holds the recorder and talks to whisper-server; it does not load
# the model itself, so a restart here is cheap and loses nothing warm.
ExecStart=%h/.config/omarchy/plugins/io.github.zedster07.desktop-agent/voice/voiced.ts
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
