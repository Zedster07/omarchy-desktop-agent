[Unit]
Description=Desktop Agent voice daemon
Documentation=https://github.com/Zedster07/omatron
After=graphical-session.target desktop-agent-stt.service
Wants=desktop-agent-stt.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/io.github.zedster07.desktop-agent/voice/voiced.ts
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=graphical-session.target
