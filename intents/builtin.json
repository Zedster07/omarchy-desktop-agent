{
  "$comment": "Built-in voice intents. Every action is a fixed argv with typed slots.\n\nWindow-scoped intents declare \"scope\": \"window\" and use the {window} placeholder. That placeholder is filled with the window that was FOCUSED WHEN YOU SPOKE, captured at key-down, not whatever happens to be focused when the command finally runs -- seconds later, after transcription and possibly an approval prompt that itself takes focus. Getting this wrong closed the wrong window.\n\nhl.dsp.window.close falls back to the FOCUSED window when its selector does not resolve, so execute.ts verifies the target still exists before dispatching and refuses if it does not. Never write a window-scoped intent without {window}.",
  "intents": [
    {
      "id": "workspace.switch",
      "phrases": [
        "workspace {n}",
        "go to workspace {n}",
        "switch to workspace {n}"
      ],
      "slots": {
        "n": {
          "type": "number",
          "min": 1,
          "max": 10
        }
      },
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.focus({ workspace = \"{n}\" })"
      ],
      "description": "Switch to a workspace"
    },
    {
      "id": "workspace.next",
      "phrases": [
        "next workspace",
        "workspace next"
      ],
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.focus({ workspace = \"e+1\" })"
      ],
      "description": "Next workspace"
    },
    {
      "id": "workspace.previous",
      "phrases": [
        "previous workspace",
        "last workspace",
        "workspace back"
      ],
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.focus({ workspace = \"e-1\" })"
      ],
      "description": "Previous workspace"
    },
    {
      "id": "window.close",
      "phrases": [
        "close window",
        "close this window",
        "close this"
      ],
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.window.close({ window = \"address:{window}\" })"
      ],
      "severity": "destructive",
      "description": "Close the window you were looking at",
      "scope": "window"
    },
    {
      "id": "window.fullscreen",
      "phrases": [
        "fullscreen",
        "full screen",
        "toggle fullscreen"
      ],
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.window.fullscreen({ mode = \"fullscreen\", window = \"address:{window}\" })"
      ],
      "description": "Fullscreen the window you were looking at",
      "scope": "window"
    },
    {
      "id": "system.lock",
      "phrases": [
        "lock screen",
        "lock the screen",
        "lock"
      ],
      "run": [
        "omarchy",
        "system",
        "lock"
      ],
      "description": "Lock the screen"
    },
    {
      "id": "audio.volume",
      "phrases": [
        "volume {n}",
        "set volume {n}",
        "volume to {n}"
      ],
      "slots": {
        "n": {
          "type": "number",
          "min": 0,
          "max": 100
        }
      },
      "run": [
        "wpctl",
        "set-volume",
        "@DEFAULT_AUDIO_SINK@",
        "{n}%"
      ],
      "description": "Set output volume"
    },
    {
      "id": "audio.mute",
      "phrases": [
        "mute",
        "mute audio",
        "mute sound"
      ],
      "run": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SINK@",
        "1"
      ],
      "description": "Mute output"
    },
    {
      "id": "audio.unmute",
      "phrases": [
        "unmute",
        "unmute audio",
        "unmute sound"
      ],
      "run": [
        "wpctl",
        "set-mute",
        "@DEFAULT_AUDIO_SINK@",
        "0"
      ],
      "description": "Unmute output"
    },
    {
      "id": "capture.screenshot",
      "phrases": [
        "screenshot",
        "take a screenshot",
        "capture screen"
      ],
      "run": [
        "omarchy",
        "capture",
        "screenshot"
      ],
      "description": "Take a screenshot"
    },
    {
      "id": "theme.set",
      "phrases": [
        "theme {name}",
        "set theme {name}",
        "switch theme to {name}"
      ],
      "slots": {
        "name": {
          "type": "text"
        }
      },
      "run": [
        "omarchy",
        "theme",
        "set",
        "{name}"
      ],
      "description": "Switch theme"
    },
    {
      "id": "app.open",
      "phrases": [
        "open {app}",
        "launch {app}",
        "start {app}",
        "open up {app}"
      ],
      "slots": {
        "app": {
          "type": "text"
        }
      },
      "run": [
        "__launch__",
        "{app}"
      ],
      "description": "Open an installed app or webapp"
    }
  ]
}