#!/usr/bin/env python3
"""Read and write the plugin's own settings.

Why a file of our own rather than shell.json: the panel is the config UI now,
and two writers on shell.json (the shell's own settings form and this) is how a
setting quietly gets lost. shell.json keeps what the BAR needs; everything the
voice and agent paths read lives here.

The remote API key is deliberately NOT kept here. It lives where voxtype reads
it, mode 0600, and this tool will report whether one is set but never print it:
a config file that echoes secrets ends up in a screenshot eventually.

  desktop-agent-config all
  desktop-agent-config get voice.sttMode
  desktop-agent-config set voice.sttMode groq
  desktop-agent-config set-secret <key>      # reads stdin if omitted
  desktop-agent-config clear-secret
  desktop-agent-config apply-stt             # push STT settings into voxtype
  desktop-agent-config stt-status            # is the speech service up
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                   "desktop-agent", "settings.json")
KEYFILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                       "desktop-agent", "stt.key")
UNIT = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                    "systemd", "user", "desktop-agent-stt.service")

DEFAULTS = {
    "voice": {
        "sttMode": "remote",                # remote | local. Remote is the
                                            # default: it needs no download.
        "localModel": "small.en",
        "remoteEndpoint": "https://api.groq.com/openai/v1/audio/transcriptions",
        "remoteModel": "whisper-large-v3-turbo",
        "biasPrompt": True,
    },
    "ai": {"assist": "route", "provider": "auto", "localModel": "llama3.2:3b"},
    "agent": {"overlayTarget": "dada.desktop-agent"},
    "command": {"enabled": True, "confirm": "destructive-only",
                "thirdParty": True, "threshold": 62},
    "policy": {"leaseMaxMinutes": 60, "recap": True, "recapIdleSec": 20},
}

# Spoken words this machine actually needs to get right. Same idea as
# ai-coworker's sttPrompt(): tell whisper what to EXPECT, because a decoder with
# no expectations turns "open" into "hope" and "CTA" into "seat A".
# Measured, not estimated. The venv is faster-whisper plus its dependencies
# (ctranslate2, onnxruntime, tokenizers, av); the model downloads on first use.
# A prompt that says "some disk space" is not consent.
VENV_MB = 432
MODEL_MB = {
    "tiny.en": 45, "base.en": 141, "base": 142, "small.en": 464,
    "distil-small.en": 250, "medium.en": 1500, "large-v3-turbo": 810,
}

BIAS_PROMPT = ("Commands: open, close, launch, workspace, volume, mute, unmute, "
               "lock screen, fullscreen, screenshot, theme, brightness, play, "
               "YouTube, Chrome, Firefox, terminal, browser, editor, files.")


def load():
    d = json.loads(json.dumps(DEFAULTS))
    try:
        cur = json.load(open(CFG))
    except Exception:
        return d
    for k, v in cur.items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            d[k].update(v)
        else:
            d[k] = v
    return d


def save(d):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, CFG)
    os.chmod(CFG, 0o600)


def has_secret():
    try:
        return bool(open(KEYFILE).read().strip())
    except Exception:
        return False


def write_secret(key):
    os.makedirs(os.path.dirname(KEYFILE), exist_ok=True)
    # 0600 before the write, not after: a key must never exist world-readable,
    # not even for the microsecond between creating the file and chmod'ing it.
    fd = os.open(KEYFILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(key.strip() + "\n")


def clear_secret():
    try:
        os.unlink(KEYFILE)
    except FileNotFoundError:
        pass


def restart_stt():
    subprocess.run(["systemctl", "--user", "restart", "desktop-agent-stt"],
                   capture_output=True)


def apply_stt():
    """Point the local speech service at the configured model and restart it.

    Remote mode needs no restart -- the daemon passes the endpoint per request,
    so switching to cloud transcription takes effect on the next utterance.
    """
    d = load()
    v = d["voice"]
    mode = v.get("sttMode", "local")

    if mode == "remote":
        if not has_secret():
            print("remote selected but no API key is set", file=sys.stderr)
            return 1
        print(f"stt -> remote ({v['remoteModel']})")
        return 0

    # Local: the model is a unit Environment=, so changing it means rewriting
    # the drop-in and restarting. Keep the rest of the unit untouched.
    want = v.get("localModel", "small.en")
    try:
        unit = open(UNIT).read()
    except Exception:
        print("no stt unit installed; run desktop-agent setup", file=sys.stderr)
        return 1
    new = re.sub(r"(?m)^Environment=DA_STT_MODEL=.*$",
                 f"Environment=DA_STT_MODEL={want}", unit)
    if new != unit:
        open(UNIT, "w").write(new)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    restart_stt()
    print(f"stt -> local ({want})")
    return 0


VENV = os.path.join(os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share"),
                    "desktop-agent", "venv")


def local_ready():
    """Is local transcription actually usable right now?"""
    py = os.path.join(VENV, "bin", "python")
    if not os.access(py, os.X_OK):
        return False
    r = subprocess.run([py, "-c", "import faster_whisper"], capture_output=True)
    return r.returncode == 0


def local_cost(model):
    """What switching to local would actually download, in MB."""
    have_venv = local_ready()
    hub = os.path.join(os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache"),
                       "huggingface", "hub")
    slug = f"models--Systran--faster-whisper-{model}"
    have_model = os.path.isdir(os.path.join(hub, slug))
    return {
        "venvMb": 0 if have_venv else VENV_MB,
        "modelMb": 0 if have_model else MODEL_MB.get(model, 500),
        "haveVenv": have_venv,
        "haveModel": have_model,
        "model": model,
    }


def install_local(model):
    """Build the local speech environment. Prints progress lines for the panel."""
    py = os.path.join(VENV, "bin", "python")
    if not os.access(py, os.X_OK):
        print("creating environment", flush=True)
        r = subprocess.run([sys.executable, "-m", "venv", VENV], capture_output=True)
        if r.returncode != 0:
            print("failed: could not create a virtualenv", flush=True)
            return 1

    if not local_ready():
        print("downloading packages (~432 MB)", flush=True)
        r = subprocess.run([os.path.join(VENV, "bin", "pip"), "install", "--quiet",
                            "--disable-pip-version-check", "faster-whisper"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"failed: {r.stderr.strip()[:160]}", flush=True)
            return 1

    mb = MODEL_MB.get(model, 500)
    print(f"downloading model {model} (~{mb} MB)", flush=True)
    code = ("from faster_whisper import WhisperModel;"
            f"WhisperModel({model!r}, device='cpu', compute_type='int8')")
    r = subprocess.run([py, "-c", code], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"failed: {r.stderr.strip()[-160:]}", flush=True)
        return 1

    d = load()
    d.setdefault("voice", {})["sttMode"] = "local"
    d["voice"]["localModel"] = model
    save(d)

    # The service only exists for local transcription, so it is installed at
    # the moment local is chosen rather than at plugin install time.
    subprocess.run(["desktop-agent", "install-stt-unit"], capture_output=True)
    subprocess.run(["systemctl", "--user", "enable", "--now",
                    "desktop-agent-stt.service"], capture_output=True)
    print("ready", flush=True)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "all"

    if cmd == "all":
        d = load()
        d["voice"]["hasRemoteKey"] = has_secret()
        print(json.dumps(d))
        return 0

    if cmd == "get":
        node = load()
        for part in (argv[2] if len(argv) > 2 else "").split("."):
            node = node.get(part) if isinstance(node, dict) else None
            if node is None:
                break
        if node is None:
            print("")
        elif isinstance(node, bool):
            print("true" if node else "false")
        elif isinstance(node, (dict, list)):
            print(json.dumps(node))
        else:
            print(node)
        return 0

    if cmd == "set":
        key, raw = argv[2], argv[3] if len(argv) > 3 else ""
        d = load()
        parts = key.split(".")
        node = d
        for p in parts[:-1]:
            node = node.setdefault(p, {})
        if raw in ("true", "false"):
            val = raw == "true"
        else:
            try:
                val = int(raw)
            except ValueError:
                val = raw
        node[parts[-1]] = val
        save(d)
        print("ok")
        return 0

    if cmd == "set-secret":
        key = argv[2] if len(argv) > 2 else sys.stdin.read().strip()
        if not key:
            print("no key given", file=sys.stderr)
            return 1
        write_secret(key)
        print("key stored")   # never the key itself
        return 0

    if cmd == "clear-secret":
        clear_secret()
        print("key cleared")
        return 0

    if cmd == "apply-stt":
        return apply_stt()

    if cmd == "local-cost":
        print(json.dumps(local_cost(argv[2] if len(argv) > 2 else
                                    load()["voice"].get("localModel", "small.en"))))
        return 0

    if cmd == "install-local":
        return install_local(argv[2] if len(argv) > 2 else
                             load()["voice"].get("localModel", "small.en"))

    if cmd == "stt-status":
        import urllib.request
        try:
            with urllib.request.urlopen("http://127.0.0.1:8791/health", timeout=2) as r:
                print(r.read().decode().strip())
        except Exception as e:
            print(f'{{"ok": false, "error": "{str(e)[:80]}"}}')
        return 0

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
