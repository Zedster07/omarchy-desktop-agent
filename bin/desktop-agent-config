#!/usr/bin/env python3
"""Read and write the plugin's own settings.

Why a file of our own rather than shell.json: the panel is the config UI now,
and two writers on shell.json (the shell's own settings form and this) is how a
setting quietly gets lost. shell.json keeps what the BAR needs; everything the
voice and agent paths read lives here.

The remote API key is deliberately NOT kept here. It lives where voxtype reads
it, mode 0600, and this tool will report whether one is set but never print it:
a config file that echoes secrets ends up in a screenshot eventually.

  desktop-agent-config all
  desktop-agent-config get voice.sttMode
  desktop-agent-config set voice.sttMode groq
  desktop-agent-config set-secret <key>      # reads stdin if omitted
  desktop-agent-config clear-secret
  desktop-agent-config apply-stt             # push STT settings into voxtype
  desktop-agent-config stt-status            # is the speech service up
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                   "desktop-agent", "settings.json")
KEYFILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                       "desktop-agent", "stt.key")
UNIT = os.path.join(os.environ.get("XDG_CONFIG_HOME", f"{HOME}/.config"),
                    "systemd", "user", "desktop-agent-stt.service")

DEFAULTS = {
    "voice": {
        "sttMode": "remote",                # remote | local. Remote is the
                                            # default: it needs no download.
        "localModel": "small.en",
        "remoteEndpoint": "https://api.groq.com/openai/v1/audio/transcriptions",
        "remoteModel": "whisper-large-v3-turbo",
        "biasPrompt": True,
    },
    "ai": {"assist": "route+plan", "provider": "auto",
           "claudeModel": "sonnet", "localModel": "llama3.2:3b"},
    "agent": {
        "overlayTarget": "io.github.zedster07.desktop-agent",
        # Anything the agent opens lands here. 0 disables confinement.
        "workspace": 10,
        # Write a markdown report after every agent run and open it. The
        # report lands in ~/.local/state/desktop-agent/runs/ either way.
        "openReport": True,
        # Which agent CLI drives the desktop at tier 4: auto | claude |
        # gemini | codex | opencode. "auto" only ever picks a runner that can
        # be confined to the desktop tools. Separate from ai.provider, which
        # picks the model that does the planning and holds no tools.
        "runner": "auto",
        # Run the agent's shell commands in a visible terminal on its
        # workspace rather than through an invisible pipe. Needs a workspace
        # (see above) so the terminal has somewhere to go.
        "visibleRuns": True,
        # Stop a hand-off after this many seconds with NOTHING happening --
        # no tool call started, none in flight. Not elapsed time: a download or
        # a page load holds the clock open for as long as it takes. Sized to
        # swallow a slow model turn rather than catch one.
        "idleSec": 120,
        # Backstop for the case idle cannot see: an agent looping productively
        # forever. Hours, not minutes -- it is there so nothing runs unattended
        # indefinitely, not to bound real work.
        "maxRunSec": 3600,
        # How many delegated subagents may run at once. Queued beyond this,
        # not refused: ten tasks at a limit of four is three waves. Capped at
        # 8 in code -- each one is a live conversation, an MCP server and a
        # share of the machine, so the ceiling is a resource fact rather than
        # a preference.
        "maxSubagents": 4,
        # Run agents that keep their own shell inside a sandbox with no
        # compositor sockets, so the shell cannot drive the desktop and every
        # action must go through the policy engine. Needs bwrap and socat.
        # Turning this off does not make those runners allowed -- it makes them
        # refused again, which is the older and worse answer.
        "sandbox": True,
        # Allow an agent CLI that cannot be limited to the desktop tools.
        #
        # Off, and it should stay off. The desktop policy only sees calls that
        # go through the desktop MCP server; an agent holding its own shell
        # runs hyprctl directly and nothing is logged or approved. Turning this
        # on does not weaken the policy -- it lets the agent walk around it.
        "allowUnconfined": False,
    },
    "command": {"enabled": True, "confirm": "destructive-only",
                "thirdParty": True, "threshold": 62},
    "policy": {"leaseMaxMinutes": 60, "recap": True, "recapIdleSec": 20},
}

# Spoken words this machine actually needs to get right. Same idea as
# ai-coworker's sttPrompt(): tell whisper what to EXPECT, because a decoder with
# no expectations turns "open" into "hope" and "CTA" into "seat A".
# Measured, not estimated. The venv is faster-whisper plus its dependencies
# (ctranslate2, onnxruntime, tokenizers, av); the model downloads on first use.
# A prompt that says "some disk space" is not consent.
VENV_MB = 432
MODEL_MB = {
    "tiny.en": 45, "base.en": 141, "base": 142, "small.en": 464,
    "distil-small.en": 250, "medium.en": 1500, "large-v3-turbo": 810,
}

BIAS_PROMPT = ("Commands: open, close, launch, workspace, volume, mute, unmute, "
               "lock screen, fullscreen, screenshot, theme, brightness, play, "
               "YouTube, Chrome, Firefox, terminal, browser, editor, files.")


def load():
    d = json.loads(json.dumps(DEFAULTS))
    try:
        cur = json.load(open(CFG))
    except Exception:
        return d
    for k, v in cur.items():
        if isinstance(v, dict) and isinstance(d.get(k), dict):
            d[k].update(v)
        else:
            d[k] = v
    return d


def save(d):
    os.makedirs(os.path.dirname(CFG), exist_ok=True)
    tmp = CFG + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, CFG)
    os.chmod(CFG, 0o600)


def has_secret():
    try:
        return bool(open(KEYFILE).read().strip())
    except Exception:
        return False


def write_secret(key):
    os.makedirs(os.path.dirname(KEYFILE), exist_ok=True)
    # 0600 before the write, not after: a key must never exist world-readable,
    # not even for the microsecond between creating the file and chmod'ing it.
    fd = os.open(KEYFILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(key.strip() + "\n")


def clear_secret():
    try:
        os.unlink(KEYFILE)
    except FileNotFoundError:
        pass


def restart_stt():
    subprocess.run(["systemctl", "--user", "restart", "desktop-agent-stt"],
                   capture_output=True)


def apply_stt():
    """Point the local speech service at the configured model and restart it.

    Remote mode needs no restart -- the daemon passes the endpoint per request,
    so switching to cloud transcription takes effect on the next utterance.
    """
    d = load()
    v = d["voice"]
    mode = v.get("sttMode", "local")

    if mode == "remote":
        if not has_secret():
            print("remote selected but no API key is set", file=sys.stderr)
            return 1
        print(f"stt -> remote ({v['remoteModel']})")
        return 0

    # Local: the model is a unit Environment=, so changing it means rewriting
    # the drop-in and restarting. Keep the rest of the unit untouched.
    want = v.get("localModel", "small.en")
    try:
        unit = open(UNIT).read()
    except Exception:
        print("no stt unit installed; run desktop-agent setup", file=sys.stderr)
        return 1
    new = re.sub(r"(?m)^Environment=DA_STT_MODEL=.*$",
                 f"Environment=DA_STT_MODEL={want}", unit)
    if new != unit:
        open(UNIT, "w").write(new)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
    restart_stt()
    print(f"stt -> local ({want})")
    return 0


VENV = os.path.join(os.environ.get("XDG_DATA_HOME", f"{HOME}/.local/share"),
                    "desktop-agent", "venv")


def local_ready():
    """Is local transcription actually usable right now?"""
    py = os.path.join(VENV, "bin", "python")
    if not os.access(py, os.X_OK):
        return False
    r = subprocess.run([py, "-c", "import faster_whisper"], capture_output=True)
    return r.returncode == 0


def local_cost(model):
    """What switching to local would actually download, in MB."""
    have_venv = local_ready()
    hub = os.path.join(os.environ.get("XDG_CACHE_HOME", f"{HOME}/.cache"),
                       "huggingface", "hub")
    slug = f"models--Systran--faster-whisper-{model}"
    have_model = os.path.isdir(os.path.join(hub, slug))
    return {
        "venvMb": 0 if have_venv else VENV_MB,
        "modelMb": 0 if have_model else MODEL_MB.get(model, 500),
        "haveVenv": have_venv,
        "haveModel": have_model,
        "model": model,
    }


def install_local(model):
    """Build the local speech environment. Prints progress lines for the panel."""
    py = os.path.join(VENV, "bin", "python")
    if not os.access(py, os.X_OK):
        print("creating environment", flush=True)
        r = subprocess.run([sys.executable, "-m", "venv", VENV], capture_output=True)
        if r.returncode != 0:
            print("failed: could not create a virtualenv", flush=True)
            return 1

    if not local_ready():
        print("downloading packages (~432 MB)", flush=True)
        r = subprocess.run([os.path.join(VENV, "bin", "pip"), "install", "--quiet",
                            "--disable-pip-version-check", "faster-whisper"],
                           capture_output=True, text=True)
        if r.returncode != 0:
            print(f"failed: {r.stderr.strip()[:160]}", flush=True)
            return 1

    mb = MODEL_MB.get(model, 500)
    print(f"downloading model {model} (~{mb} MB)", flush=True)
    code = ("from faster_whisper import WhisperModel;"
            f"WhisperModel({model!r}, device='cpu', compute_type='int8')")
    r = subprocess.run([py, "-c", code], capture_output=True, text=True)
    if r.returncode != 0:
        print(f"failed: {r.stderr.strip()[-160:]}", flush=True)
        return 1

    d = load()
    d.setdefault("voice", {})["sttMode"] = "local"
    d["voice"]["localModel"] = model
    save(d)

    # The service only exists for local transcription, so it is installed at
    # the moment local is chosen rather than at plugin install time.
    subprocess.run(["desktop-agent", "install-stt-unit"], capture_output=True)
    subprocess.run(["systemctl", "--user", "enable", "--now",
                    "desktop-agent-stt.service"], capture_output=True)
    print("ready", flush=True)
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "all"

    if cmd == "forget":
        # Clear the conversational memory. Not a setting -- an action, because
        # "forget what I just said" is a thing people want immediately and
        # should not have to find in a menu.
        path = os.path.expanduser("~/.local/state/desktop-agent/history.jsonl")
        try:
            open(path, "w").close()
            print("forgotten")
        except OSError as e:
            print(f"could not clear history: {e}")
            return 1
        return 0

    if cmd == "history":
        path = os.path.expanduser("~/.local/state/desktop-agent/history.jsonl")
        try:
            print(open(path).read().rstrip() or "(empty)")
        except OSError:
            print("(empty)")
        return 0

    # A commented file means "looks like the setting" is not the same as "is
    # the setting". The shipped policy's own header carries the line
    #   //  Emergency stop:  set "enabled": false
    # which matches the key regex, sits above the yolo block, and would have
    # been the line these setters rewrote -- editing a comment while reporting
    # success, on a fresh install, for the switch that governs everything.
    def _is_code(line):
        return not line.lstrip().startswith("//")

    if cmd in ("policy-enabled", "policy-set-enabled"):
        # The MASTER switch, the one at the top of the policy.
        #
        # Separate from the panel's kill switch, which writes a flag file, and
        # the panel had been reporting the flag while the policy said something
        # else -- so a fresh install showed "policy active" while every gated
        # action refused. Two off switches, one of them invisible.
        import re
        path = os.path.expanduser("~/.config/desktop-agent/policy.jsonc")
        try:
            lines = open(path).read().split("\n")
        except OSError:
            print("false" if cmd == "policy-enabled" else "no policy")
            return 0 if cmd == "policy-enabled" else 1

        # The first "enabled" outside the yolo block. Position matters: the
        # yolo block has one too, and flipping the wrong one either grants
        # unattended approvals or switches the whole plugin off.
        yolo = next((i for i, l in enumerate(lines)
                     if _is_code(l) and re.match(r'\s*"yolo"\s*:', l)), len(lines))
        target = next((i for i in range(len(lines))
                       if i < yolo and _is_code(lines[i])
                       and re.search(r'"enabled"\s*:\s*(true|false)', lines[i])), None)
        if target is None:
            print("false" if cmd == "policy-enabled" else "no enabled key")
            return 0 if cmd == "policy-enabled" else 1

        if cmd == "policy-enabled":
            print(re.search(r'"enabled"\s*:\s*(true|false)', lines[target]).group(1))
            return 0

        want = (argv[2] if len(argv) > 2 else "").lower()
        if want not in ("true", "false"):
            print("usage: desktop-agent-config policy-set-enabled true|false")
            return 1
        lines[target] = re.sub(r'("enabled"\s*:\s*)(true|false)', r'\g<1>' + want, lines[target])
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines))
        os.replace(tmp, path)
        print(want)
        return 0

    if cmd == "policy-set-yolo":
        # Flip the policy's full-access switch, from the panel.
        #
        # This used to be something people were told to edit by hand, on the
        # reasoning that a file is somewhere an agent cannot reach. That was
        # protection by location: it only held while the switch stayed
        # inconvenient. The agent is now locked out of the UI by geometry and
        # out of this command by voice/safety.ts, so the switch can live where
        # someone can find it.
        #
        # Edited line by line, not by re-serialising: policy.jsonc is a
        # commented file whose comments explain what every setting does, and
        # json.dump would silently delete all of them.
        import re
        want = (argv[2] if len(argv) > 2 else "").lower()
        if want not in ("true", "false"):
            print("usage: desktop-agent-config policy-set-yolo true|false")
            return 1
        path = os.path.expanduser("~/.config/desktop-agent/policy.jsonc")
        try:
            lines = open(path).read().split("\n")
        except OSError as e:
            print(f"could not read the policy: {e}")
            return 1

        # Find the "enabled" belonging to the yolo block, not the master switch
        # that shares its name at the top of the file.
        start = next((i for i, l in enumerate(lines)
                      if _is_code(l) and re.match(r'\s*"yolo"\s*:', l)), None)
        if start is None:
            print("no yolo block in the policy")
            return 1
        target = next((i for i in range(start, min(start + 12, len(lines)))
                       if _is_code(lines[i])
                       and re.search(r'"enabled"\s*:\s*(true|false)', lines[i])), None)
        if target is None:
            print("no enabled key inside the yolo block")
            return 1

        lines[target] = re.sub(r'("enabled"\s*:\s*)(true|false)', r'\g<1>' + want, lines[target])
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(lines))
        os.replace(tmp, path)
        print(want)
        return 0

    if cmd == "policy-yolo":
        # Does the POLICY permit a lease at all?
        #
        # Granting one from the panel writes yolo.json, but the server checks
        # policy.yolo.enabled before honouring it. With that false the panel
        # cheerfully counts down "full access · 50:00 left" while every single
        # action still stops for approval -- the switch appears to work and
        # changes nothing.
        import re
        path = os.path.expanduser("~/.config/desktop-agent/policy.jsonc")
        try:
            raw = open(path).read()
        except OSError:
            print("false"); return 0
        # Comment-stripping good enough for one boolean: drop // lines, then
        # find the yolo block and read its "enabled".
        body = re.sub(r"^\s*//.*$", "", raw, flags=re.M)
        m = re.search(r'"yolo"\s*:\s*\{[^}]*?"enabled"\s*:\s*(true|false)', body, re.S)
        print("true" if (m and m.group(1) == "true") else "false")
        return 0

    if cmd == "all":
        d = load()
        d["voice"]["hasRemoteKey"] = has_secret()
        print(json.dumps(d))
        return 0

    if cmd == "get":
        node = load()
        for part in (argv[2] if len(argv) > 2 else "").split("."):
            node = node.get(part) if isinstance(node, dict) else None
            if node is None:
                break
        if node is None:
            print("")
        elif isinstance(node, bool):
            print("true" if node else "false")
        elif isinstance(node, (dict, list)):
            print(json.dumps(node))
        else:
            print(node)
        return 0

    if cmd == "set":
        key, raw = argv[2], argv[3] if len(argv) > 3 else ""
        d = load()
        parts = key.split(".")
        node = d
        for p in parts[:-1]:
            node = node.setdefault(p, {})
        if raw in ("true", "false"):
            val = raw == "true"
        else:
            try:
                val = int(raw)
            except ValueError:
                val = raw
        node[parts[-1]] = val
        save(d)
        print("ok")
        return 0

    if cmd == "set-secret":
        key = argv[2] if len(argv) > 2 else sys.stdin.read().strip()
        if not key:
            print("no key given", file=sys.stderr)
            return 1
        write_secret(key)
        print("key stored")   # never the key itself
        return 0

    if cmd == "clear-secret":
        clear_secret()
        print("key cleared")
        return 0

    if cmd == "apply-stt":
        return apply_stt()

    if cmd == "local-cost":
        print(json.dumps(local_cost(argv[2] if len(argv) > 2 else
                                    load()["voice"].get("localModel", "small.en"))))
        return 0

    if cmd == "install-local":
        return install_local(argv[2] if len(argv) > 2 else
                             load()["voice"].get("localModel", "small.en"))

    if cmd == "stt-status":
        import urllib.request
        port = int(os.environ.get("DA_STT_PORT", "8791"))
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=2) as r:
                print(r.read().decode().strip())
        except Exception as e:
            print(f'{{"ok": false, "error": "{str(e)[:80]}"}}')
        return 0

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
