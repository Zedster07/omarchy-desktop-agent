#!/usr/bin/env bash
# Arms command mode: record, but send the transcript to a file instead of
# typing it, and let a watcher turn it into an action.
#
# Why not voxtype's post_process hook, which was the obvious route: that hook
# cannot suppress output. Returning an empty string to mean "don't type this"
# is treated by voxtype as a failed post-processor, and it falls back to typing
# the ORIGINAL transcript -- so "workspace nine" got typed instead of switching
# workspace. `record start --file` is the supported way to get a transcript
# without it being typed, and it has the added virtue of leaving dictation
# completely alone: with this design there is no hook, so the F9 path runs
# exactly the code it ran before this plugin was installed.
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-agent"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
RESULT="$STATE/command-result.txt"

mkdir -p "$STATE"

if ! command -v voxtype >/dev/null 2>&1; then
  notify-send -a "Desktop Agent" "Voice commands need voxtype" \
    "Install it with: omarchy pkg add voxtype-bin" 2>/dev/null || true
  exit 1
fi

# A stale result from a previous run must never be mistaken for this one.
rm -f "$RESULT"

voxtype record start --file "$RESULT" >/dev/null 2>&1

# The watcher outlives this process: recording ends on key release, and
# transcription takes a few seconds after that.
BUN="$(command -v bun || true)"
if [[ -n "$BUN" ]]; then
  setsid "$BUN" "$HERE/voice/watch.ts" "$RESULT" >/dev/null 2>&1 &
else
  notify-send -a "Desktop Agent" "Voice commands need bun" 2>/dev/null || true
fi
