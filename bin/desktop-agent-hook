#!/usr/bin/env bash
# Voxtype post-processing hook.
#
# Dictation is the overwhelmingly common path and it must cost nothing. This
# wrapper exists so that path never starts a runtime: no flag file means `cat`,
# which is a few milliseconds, instead of ~250ms of Bun startup added to every
# single thing you dictate.
#
# Only when command mode is armed does the real matcher get loaded.
set -euo pipefail

FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-agent/command-mode"

# Fast path: not a command, so hand the text straight back.
if [[ ! -e "$FLAG" ]]; then
  exec cat
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUN="$(command -v bun || true)"

if [[ -z "$BUN" ]]; then
  # No runtime: fail open as dictation rather than eating the user's words.
  rm -f "$FLAG"
  exec cat
fi

exec "$BUN" "$HERE/voice/hook.ts"
