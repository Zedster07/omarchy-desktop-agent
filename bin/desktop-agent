#!/usr/bin/env bash
# Desktop Agent setup and health check.
#
# Omarchy never runs an install hook for a plugin, by design -- adding a plugin
# must not be able to execute anything. So this is explicit and user-invoked:
# nothing here happens because you installed the plugin, only because you ran
# this or pressed the button in the panel.
set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
UNITS="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"




bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

doctor() {
  local missing=0
  bold "Desktop Agent — health check"

  echo; bold "Voice"
  for c in pw-record wtype socat wl-copy; do
    if have "$c"; then ok "$c"; else bad "$c is missing"; missing=1; fi
  done

  local sttmode; sttmode="$(desktop-agent-config get voice.sttMode 2>/dev/null || echo local)"

  if [[ "$sttmode" == "remote" ]]; then
    # Nothing local is required for a cloud endpoint, so nothing local is checked.
    ok "remote transcription (no local model, no venv)"
  else
    local venv="$HOME/.local/share/desktop-agent/venv"
    if [[ -x "$venv/bin/python" ]] && "$venv/bin/python" -c "import faster_whisper" 2>/dev/null; then
      ok "faster-whisper installed ($(du -sh "$venv" 2>/dev/null | cut -f1))"
    else
      bad "faster-whisper missing  (run: desktop-agent setup)"; missing=1
    fi

    local health
    health="$(desktop-agent-config stt-status 2>/dev/null)"
    if [[ "$health" == *'"ok": true'* ]]; then
      ok "speech service up — $(echo "$health" | grep -oE '"model": "[^"]+"' | cut -d'"' -f4)"
    else
      bad "speech service down  (systemctl --user start desktop-agent-stt)"; missing=1
    fi
  fi

  if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/desktop-agent-voice.sock" ]]; then
    ok "voice daemon running"
  else
    bad "voice daemon down  (systemctl --user start desktop-agent-voice)"; missing=1
  fi

  if [[ "$(desktop-agent-config get voice.sttMode 2>/dev/null)" == "remote" ]]; then
    if desktop-agent-config all 2>/dev/null | grep -q '"hasRemoteKey": true'; then
      ok "remote transcription configured"
    else
      bad "remote selected but no API key set"; missing=1
    fi
  fi

  if [[ "$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)" == *"1"* ]] \
     || [[ "$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)" == *"true"* ]]; then
    ok "compositor blur on (overlays read as a HUD)"
  else
    warn "compositor blur off — overlays still work, they just look flat  (desktop-agent keybinds)"
  fi

  if [[ -f "$HOME/.config/hypr/bindings.lua" ]] && grep -q "desktop-agent-listen" "$HOME/.config/hypr/bindings.lua" 2>/dev/null; then
    ok "command-mode keybinding present"
  else
    warn "no command-mode keybinding  (run: desktop-agent keybinds)"
  fi

  echo; bold "Policy"
  if [[ -f "$HOME/.config/desktop-agent/policy.jsonc" ]]; then
    ok "policy present"
  else
    bad "no policy — everything gated will refuse  (run: desktop-agent setup)"; missing=1
  fi
  if [[ -e "${XDG_STATE_HOME:-$HOME/.local/state}/desktop-agent/disabled" ]]; then
    warn "kill switch is ON — every gated action refuses"
  fi

  echo; bold "Agent (optional — voice works without this)"
  if have bun; then ok "bun ($(command -v bun))"; else warn "bun is missing; the MCP half will not run"; fi

  echo; bold "Shell"
  if qs -p /usr/share/omarchy/shell ipc call io.github.zedster07.desktop-agent status >/dev/null 2>&1; then
    ok "plugin service is live"
  else
    bad "plugin service is not responding — is the plugin enabled in shell.json?"; missing=1
  fi

  echo
  [[ $missing -eq 0 ]] && bold "All good." || bold "Run: desktop-agent setup"
  return $missing
}

# Omarchy binds dictation itself (F9 push-to-talk, SUPER+CTRL+X toggle), so
# this adds exactly one binding: the one that arms command mode before handing
# off to voxtype. Existing dictation muscle memory is left alone.
# Omarchy binds dictation itself (F9 push-to-talk, SUPER+CTRL+X toggle), so
# this adds exactly one binding: the one that arms command mode. Existing
# dictation muscle memory is left alone.
#
# The blur block is optional but is what makes the voice HUD read as a heads-up
# display rather than a window. It is close to free on a default Omarchy setup
# because every window is fully opaque, so there is nothing translucent for the
# compositor to blur behind -- the cost lands only on the two layer rules, and
# only while one of those surfaces is on screen.
keybinds() {
  cat <<'BINDS'

Add to ~/.config/hypr/bindings.lua:

    -- This plugin owns the speech path now, so unbind voxtype's keys first;
    -- two things listening on one key race for the microphone.
    hl.unbind("F9")
    hl.unbind("SUPER + CTRL + X")

    o.bind("F9",  "Dictate",             "desktop-agent-listen start dictate")
    o.bind("F9",  "Dictate (stop)",      "desktop-agent-listen stop",    { release = true })
    o.bind("F10", "Voice command",       "desktop-agent-listen start command")
    o.bind("F10", "Voice command (stop)","desktop-agent-listen stop",    { release = true })
    o.bind("SUPER + ESCAPE", "Cancel voice", "desktop-agent-listen cancel")

    -- Type a request instead of speaking it. Same pipeline behind it.
    o.bind("SUPER + SLASH", "Command prompt",
           "omarchy-shell shell call io.github.zedster07.desktop-agent prompt")

Optional, in ~/.config/hypr/looknfeel.lua, for blur behind the overlays:

    hl.config({
      decoration = { blur = { enabled = true, size = 6, passes = 2,
                              new_optimizations = true, ignore_opacity = true } },
    })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-voice" }, blur = true })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-approval" }, blur = true })
    hl.layer_rule({ match = { namespace = "omarchy-desktop-agent-prompt" }, blur = true })

BINDS
}

case "${1:-doctor}" in
  doctor) doctor ;;
  setup)
    mkdir -p "$HOME/.config/desktop-agent" "$UNITS"

    # Seed the policy on first run.
    #
    # Without a policy the engine fails closed and refuses everything, which is
    # correct and looks completely broken. An existing policy is never touched:
    # it is the security boundary and the user's own edits live in it.
    if [[ ! -f "$HOME/.config/desktop-agent/policy.jsonc" ]]; then
      cp "$PLUGIN_DIR/server/policy.default.jsonc" "$HOME/.config/desktop-agent/policy.jsonc"
      ok "policy seeded at ~/.config/desktop-agent/policy.jsonc"
    else
      ok "policy already present — left alone"
    fi
    bun_path="$(command -v bun || echo /usr/bin/bun)"
    sed -e "s|ExecStart=.*voiced.ts|ExecStart=$bun_path $PLUGIN_DIR/voice/voiced.ts|" \
        "$PLUGIN_DIR/systemd/desktop-agent-voice.service" > "$UNITS/desktop-agent-voice.service"
    systemctl --user daemon-reload
    systemctl --user enable --now desktop-agent-voice.service
    ok "voice daemon started"

    # Nothing is downloaded here. Transcription defaults to a cloud endpoint,
    # which needs a key and no disk; local is offered in the panel and only
    # installs after an explicit yes with the size on screen.
    if desktop-agent-config all 2>/dev/null | grep -q '"hasRemoteKey": true'; then
      ok "API key set — transcription ready"
    else
      echo
      bold "One thing left: an API key"
      echo "  Transcription runs against a cloud endpoint by default, so there is"
      echo "  nothing to download. Get a free key at https://console.groq.com and"
      echo "  paste it into the panel's voice tab."
      echo
      echo "  Prefer to keep audio on this machine? Pick 'local' in the same tab."
      echo "  It will tell you the download size and ask before fetching anything."
    fi

    keybinds
    doctor
    ;;
  mcp-install)
    # Register the MCP server that ships WITH this plugin.
    #
    # Point it at our own copy rather than at whatever is in ~/.config: the
    # server, the policy engine and the approval overlay are one thing, and a
    # plugin that half-works because it is driving someone else's server is
    # not a plugin anyone can ship.
    have bun || { bad "bun is required for the agent half"; exit 1; }
    if [[ ! -d "$PLUGIN_DIR/server/node_modules" ]]; then
      bold "Installing server dependencies"
      (cd "$PLUGIN_DIR/server" && bun install) || { bad "bun install failed"; exit 1; }
    fi
    python3 - "$PLUGIN_DIR" "$(command -v bun)" <<'PY'
import json, os, shutil, sys, time
plugin, bun = sys.argv[1], sys.argv[2]
cfg = os.path.expanduser("~/.claude.json")
if not os.path.exists(cfg):
    print("  no ~/.claude.json — start Claude Code once first"); sys.exit(1)
shutil.copy(cfg, f"{cfg}.bak.{int(time.time())}")
d = json.load(open(cfg))
servers = d.setdefault("mcpServers", {})
servers["desktop"] = {
    "type": "stdio",
    "command": bun,
    "args": ["run", os.path.join(plugin, "server", "server.ts")],
    "env": {},
}
json.dump(d, open(cfg, "w"), indent=2)
print(f"  registered: {os.path.join(plugin, 'server', 'server.ts')}")
print("  (previous ~/.claude.json backed up alongside)")
PY
    ok "MCP server registered — restart Claude Code to pick it up"
    ;;

  install-stt-unit)
    # Called by desktop-agent-config when someone opts into local. The unit is
    # not installed at plugin-install time because most users will never run a
    # local model.
    mkdir -p "$UNITS"
    venv="$HOME/.local/share/desktop-agent/venv"
    sed -e "s|ExecStart=%h/.local/share/desktop-agent/venv/bin/python .*|ExecStart=$venv/bin/python $PLUGIN_DIR/stt/server.py|" \
        "$PLUGIN_DIR/systemd/desktop-agent-stt.service" > "$UNITS/desktop-agent-stt.service"
    systemctl --user daemon-reload
    ;;
  keybinds) keybinds ;;
  *) echo "usage: desktop-agent [doctor|setup|mcp-install|keybinds]"; exit 2 ;;
esac
