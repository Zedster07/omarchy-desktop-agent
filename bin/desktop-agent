#!/usr/bin/env bash
# Desktop Agent setup and health check.
#
# Omarchy never runs an install hook for a plugin, by design -- adding a plugin
# must not be able to execute anything. So this is explicit and user-invoked:
# nothing here happens because you installed the plugin, only because you ran
# this or pressed the button in the panel.
set -uo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"




bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }

have() { command -v "$1" >/dev/null 2>&1; }

doctor() {
  local missing=0
  bold "Desktop Agent — health check"

  echo; bold "Voice"
  if have voxtype; then
    ok "voxtype $(voxtype --version 2>/dev/null | awk '{print $2}')"
  else
    bad "voxtype is missing — Omarchy normally ships it (omarchy pkg add voxtype-bin)"; missing=1
  fi

  if have wtype || have ydotool; then ok "text injection available"; else warn "neither wtype nor ydotool found"; fi

  # The hook is what makes spoken commands possible at all. Without it voxtype
  # types every phrase, including the ones meant as commands.
  # Nothing to check in voxtype's config any more. Command mode uses
  # `voxtype record start --file`, so dictation runs the exact code path it
  # ran before this plugin existed -- no hook, no post-processor, no tax.
  if [[ -f "$HOME/.config/hypr/bindings.lua" ]] && grep -q "desktop-agent-arm" "$HOME/.config/hypr/bindings.lua" 2>/dev/null; then
    ok "command-mode keybinding present"
  else
    warn "no command-mode keybinding  (run: desktop-agent keybinds)"
  fi

  echo; bold "Agent (optional — voice works without this)"
  if have bun; then ok "bun ($(command -v bun))"; else warn "bun is missing; the MCP half will not run"; fi

  echo; bold "Shell"
  if qs -p /usr/share/omarchy/shell ipc call io.github.zedster07.desktop-agent status >/dev/null 2>&1; then
    ok "plugin service is live"
  else
    bad "plugin service is not responding — is the plugin enabled in shell.json?"; missing=1
  fi

  echo
  [[ $missing -eq 0 ]] && bold "All good." || bold "Run: desktop-agent setup"
  return $missing
}

# Omarchy binds dictation itself (F9 push-to-talk, SUPER+CTRL+X toggle), so
# this adds exactly one binding: the one that arms command mode before handing
# off to voxtype. Existing dictation muscle memory is left alone.
keybinds() {
  local flag="\${XDG_STATE_HOME:-$HOME/.local/state}/desktop-agent/command-mode"
  cat <<BINDS

Add to ~/.config/hypr/bindings.lua:

    -- desktop-agent command mode: arm the flag, then record as usual.
    o.bind("SUPER + SHIFT + D", "Voice command", "desktop-agent-arm")

Dictation is unchanged and still Omarchy's own:
    F9              push-to-talk dictation
    SUPER + CTRL+X  toggle dictation

BINDS
}

case "${1:-doctor}" in
  doctor) doctor ;;
  setup)
    have voxtype || { bad "voxtype is not installed"; echo "    omarchy pkg add voxtype-bin"; exit 1; }
    mkdir -p "$HOME/.config/desktop-agent"
    keybinds
    doctor
    ;;
  keybinds) keybinds ;;
  *) echo "usage: desktop-agent [doctor|setup|keybinds]"; exit 2 ;;
esac
